# dependencies
node_modules/
.worktrees/

# 本机审计/冒烟脚本与原始输出（可复核，但不入库；内含数据库副本，勿提交）
.recon/

# 本机打包用的 PowerShell shim（内含本机绝对路径；electron-builder 26 需要它才能取到依赖树）
# 注意：npm.ps1 必须纯 ASCII —— PowerShell 5.1 会把无 BOM 的 ps1 按 GBK 解码，
# 带中文注释会导致脚本体静默不执行、打包报 "No JSON content found in output"。
.pshims/

# next.js
.next/
out/
next-env.d.ts

# database（首次运行执行 npm run db:push 自动创建）
db/
*.db

# 本地 PDF 入库（不要误伤 src/lib/library 源码）
/library/

# env & secrets
.env
.env.local
.env.*.local

# logs
*.log

# playwright e2e
test-results/
playwright-report/
blob-report/

# electron 打包产物
release/

# 桌面端构建产物（standalone 压缩包 + 数据库模板，由 desktop:prepare 生成）
resources/

